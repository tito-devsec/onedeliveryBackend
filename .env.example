# ═══════════════════════════════════════════════════════════════════
# One Delivery Backend v2 — Environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── JWT (generate with: openssl rand -hex 64) ───────────────────────
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX
JWT_REFRESH_EXPIRES_IN=30d

# ── MySQL ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=onedelivery
DB_USER=onedelivery_user
DB_PASS=REPLACE_WITH_STRONG_DB_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=20

# ── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ── Cloudinary (image uploads: products, categories, docs, avatars) ──
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# ── Snippe Payment Gateway ───────────────────────────────────────────
SNIPPE_API_KEY=snp_REPLACE_ME
SNIPPE_WEBHOOK_URL=https://api.onedelivery.co.tz/api/payment/webhook
SNIPPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Firebase Cloud Messaging (push notifications) ────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ── Google sign-in (mobile apps) ─────────────────────────────────────
# OAuth "Web client" ID from the Firebase project (Authentication → Google →
# Web SDK configuration). Comma-separate if there is more than one.
GOOGLE_CLIENT_IDS=REPLACE_ME.apps.googleusercontent.com

# ── Google Maps (server-side) ────────────────────────────────────────
# Key restricted to this server's IP, with these APIs enabled:
# Routes API, Places API (New), Geocoding API. Used for road routes, live ETAs
# and address search in both apps. Without it the apps fall back to straight lines.
GOOGLE_MAPS_API_KEY=REPLACE_ME
# true = live-traffic routes (billed at the Routes "Pro" rate)
MAPS_TRAFFIC_AWARE=false

# Pickup point for OneDelivery's own store items (products with no seller shop)
STORE_PICKUP_LAT=
STORE_PICKUP_LNG=
STORE_PICKUP_NAME=OneDelivery Store
STORE_PICKUP_ADDRESS=
STORE_PICKUP_PHONE=

# ── App URLs ─────────────────────────────────────────────────────────
CLIENT_URL=https://onedelivery.co.tz
API_URL=https://api.onedelivery.co.tz
ADMIN_EMAIL=admin@onedelivery.co.tz

# ── Commerce defaults ─────────────────────────────────────────────────
BASE_SHIPPING_COST=2000
TAX_RATE=0.18

# ── Security / CORS ───────────────────────────────────────────────────
CORS_ORIGIN=https://onedelivery.co.tz,https://admin.onedelivery.co.tz
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Out-of-app email (Brevo SMTP) — verification codes + notifications ─
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME@smtp-brevo.com
SMTP_PASS=REPLACE_ME
SMTP_FROM_EMAIL=no-reply@mail.onedelivery.co.tz
MAIL_FROM=One Delivery <no-reply@mail.onedelivery.co.tz>

# ── SMS / OTP (Brevo transactional SMS) ──────────────────────────────
BREVO_API_KEY=xkeysib-REPLACE_ME
OTP_ENABLED=true
SMS_PROVIDER=brevo
SMS_SENDER_ID=OneDeliver
