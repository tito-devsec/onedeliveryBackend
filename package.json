{
  "name": "onedelivery-backend",
  "version": "2.0.0",
  "description": "OneDelivery Production Backend — MySQL + Redis + Socket.io + Snippe",
  "main": "src/server.js",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "start":        "node src/server.js",
    "dev":          "node --watch src/server.js",
    "db:migrate":   "node src/config/migrate.js",
    "db:seed":      "node src/config/seed.js",
    "db:seed-admin": "node src/config/seed-admin.js"
  },
  "dependencies": {
    "bcryptjs":           "^2.4.3",
    "cloudinary":         "^2.8.0",
    "compression":        "^1.7.4",
    "cors":               "^2.8.5",
    "dotenv":             "^16.4.7",
    "express":            "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin":     "^12.0.0",
    "helmet":             "^8.0.0",
    "ioredis":            "^5.4.1",
    "jsonwebtoken":       "^9.0.2",
    "multer":             "^1.4.5-lts.1",
    "mysql2":             "^3.11.3",
    "nodemailer":         "^6.9.14",
    "socket.io":          "^4.7.5",
    "uuid":               "^11.0.3"
  }
}
